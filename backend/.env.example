# Server & Environment
PORT=3000
NODE_ENV=development
SESSION_SECRET=change-this-to-a-long-random-secret
FRONTEND_URL=http://localhost:5173

# Demo Mode Toggle (true: hiển thị nút đăng nhập nhanh Admin/User; false: tắt hoàn toàn)
# Mặc định: development -> true, production -> false
ENABLE_DEMO_LOGIN=true

# OIDC Providers Activation (true: kích hoạt & hiển thị ở màn hình Login; false: tắt)
ENABLE_GOOGLE_AUTH=true
ENABLE_SDV_AUTH=true

# Google OIDC
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxx
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# SDV OIDC (WSO2 Identity Server)
# Hỗ trợ cả key OIDC_* và SDV_*
OIDC_PROVIDER_NAME=SDV SSO
OIDC_DOMAIN=https://identity.company.com
OIDC_CLIENT_ID=xxx
OIDC_CLIENT_SECRET=xxx
OIDC_CALLBACK_URL=http://localhost:3000/api/auth/sdv/callback

# SQLite
DB_PATH=./data/survey.db

# Admin (comma-separated emails)
ADMIN_EMAILS=admin@company.com
